<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lifelink_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/lifelink_logo_background"
            android:gravity="center"
            android:text="♥"
            android:textColor="@color/lifelink_white"
            android:textSize="54sp"
            android:contentDescription="LifeLink heart logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="LifeLink"
            android:textColor="@color/lifelink_red"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Donate blood. Save lives."
            android:textColor="@color/lifelink_text"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:text="A little of your blood can give someone another chance at life. Join our community of donors and make every drop count."
            android:textColor="@color/lifelink_secondary_text"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:background="@color/lifelink_white"
            android:elevation="3dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Every drop matters"
                android:textColor="@color/lifelink_red"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Find donors, request blood, and help people in need."
                android:textColor="@color/lifelink_secondary_text"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnGetStarted"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/lifelink_red"
                android:text="Get Started"
                android:textAllCaps="false"
                android:textColor="@color/lifelink_white"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/lifelink_white"
                android:text="I already have an account"
                android:textAllCaps="false"
                android:textColor="@color/lifelink_red"
                android:textSize="15sp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="Together, we can save lives."
            android:textColor="@color/lifelink_secondary_text"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
